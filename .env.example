# 預設 SIM（模擬下單）；確認永豐金憑證與風控測試通過後才可改為 LIVE
TRADING_MODE=SIM
CHECK_TV_IP=true
TV_WEBHOOK_SECRET=SYNAPSE_TV_SECRET_2026

# FinMind API v4 Token（可填多組，以逗號分隔輪替）
FINMIND_TOKENS=

# 六模型 AI API 與地端模型設定（可依需求填入任一或全部）
# 1. Groq 極速推理（推薦用於高波動盤中極速判斷）
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. 地端模型 / Ollama（支援 Ollama 原生 /api/chat 或 OpenAI 相容端點如 LM Studio / vLLM）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# 3. xAI Grok / Google Gemini / Anthropic Claude / OpenAI ChatGPT
XAI_API_KEY=
GROK_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 伺服器加密主金鑰（選填；未填時自動於本機生成 0600 權限 .synapse_secret.key 加密儲存 Bot Token）
SYNAPSE_MASTER_KEY=

# LINE Messaging API Bot & Telegram Bot
# Telegram 僅需於網頁設定頁貼上 Bot Token 並傳送一次性 /start <setup_code> 即可自動綁定，免手動填寫 Chat ID
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
TELEGRAM_BOT_TOKEN=

# 永豐金 Shioaji 實盤設定（僅 LIVE 模式需要，切勿上傳至公開 Git）
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_CA_PATH=./certs/Sinopac.pfx
SHIOAJI_CA_PASS=
